import React, { useEffect, useState, useRef } from "react";
import html2pdf from "html2pdf.js"; 
import { UPIQR } from '@adityavijay21/upiqr';
import logo from '../../assets/logo.png'

import api from "../../services/api";
import notify from "../../components/ui/notify";
import { 
  Package, 
  Plus, 
  ShoppingCart, 
  Users as UsersIcon, 
  Search, 
  Trash2, 
  AlertTriangle,
  Download,
  Printer,
  Eye,
  X,
} from "lucide-react";

const API_PRODUCTS = "/products";
const API_BILLS = "/bills";
const API_GENERAL_SETTINGS = "/general-settings/get";
const API_CUSTOMERS = "/customers";

const TrashIcon = ({ size = 16 }) => (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
    <polyline points="3 6 5 6 21 6" />
    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
    <line x1="10" y1="11" x2="10" y2="17" />
    <line x1="14" y1="11" x2="14" y2="17" />
  </svg>
);

export default function BillingPage() {
  const [generalSettings, setGeneralSettings] = useState(null);
  const [products, setProducts] = useState([]);
  const [selectedProduct, setSelectedProduct] = useState("");
  const [qty, setQty] = useState("");

  const [items, setItems] = useState([]);
  const [customer, setCustomer] = useState({ name: "", phone: "" });
  const [discount, setDiscount] = useState(0);
  const [payment, setPayment] = useState("Cash");
  const [paymentType, setPaymentType] = useState("full"); // 'full' or 'partial'
  const [amountPaid, setAmountPaid] = useState(0);

  const [productSearch, setProductSearch] = useState("");
  const [bills, setBills] = useState([]);

  const [logoSrc, setLogoSrc] = useState('');

  // Customers
  const [customers, setCustomers] = useState([]);
  const [customerSearch, setCustomerSearch] = useState("");
  const [selectedCustomerId, setSelectedCustomerId] = useState(null);
  const [savingCustomer, setSavingCustomer] = useState(false);
  const [pendingInfo, setPendingInfo] = useState(null);
  const [showPendingDetails, setShowPendingDetails] = useState(false);

  // Bills list state
  const [billSearch, setBillSearch] = useState('');
  const [billStatusFilter, setBillStatusFilter] = useState('All');
  const [selectedBill, setSelectedBill] = useState(null);


  useEffect(() => {
    fetchProducts();
    fetchBills();
    fetchGeneralSettings();
    fetchCustomers();
  }, []);

  useEffect(() => {
    const img = new Image();
    img.onload = () => {
      const canvas = document.createElement('canvas');
      canvas.width = img.width;
      canvas.height = img.height;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(img, 0, 0);
      setLogoSrc(canvas.toDataURL('image/png'));
    };
    img.src = logo;
  }, [])

  const fetchProducts = async () => {
    try {
      const res = await api.get(API_PRODUCTS);
      const data = res.data;
      setProducts(Array.isArray(data) ? data : []);
    } catch {
      setProducts([]);
    }
  };

  const fetchCustomers = async () => {
    try {
      const res = await api.get(API_CUSTOMERS);
      const data = res.data;
      // Handle both array and {success,data}
      const list = Array.isArray(data) ? data : (data?.data || []);
      setCustomers(Array.isArray(list) ? list : []);
    } catch {
      setCustomers([]);
    }
  };

  // ---------------------- FETCH BILLS ----------------------
  const fetchBills = async () => {
    try {
      const res = await api.get(API_BILLS);
      const data = res.data;
      setBills(Array.isArray(data) ? data : []);
    } catch {
      setBills([]);
    }
  };

  const fetchGeneralSettings = async () => {
    try {
      const res = await api.get(API_GENERAL_SETTINGS);
      const data = res.data;
      setGeneralSettings(data && data.success ? data.data : null);
    } catch {
      setGeneralSettings(null);
    }
  };

  // ---------------------- FILTER PRODUCTS ----------------------
  const filteredProducts = products.filter((p) =>
    p.name?.toLowerCase().includes(productSearch.toLowerCase())
  );

  // ---------------------- FILTER CUSTOMERS ----------------------
  const filteredCustomers = customers.filter((c) => {
    const q = customerSearch.trim().toLowerCase();
    if (!q) return false;
    return (
      c.name?.toLowerCase().includes(q) ||
      String(c.phone || c.mobile || "").toLowerCase().includes(q)
    );
  });

  const selectCustomer = (c) => {
    const cId = c._id || c.id || null;
    setSelectedCustomerId(cId);
    setCustomer({
      name: c.name || "",
      address: c.address || "",
      phone: c.phone || c.mobile || "",
      email: c.email || "",
    });
    setCustomerSearch(`${c.name}${c.phone ? ` (${c.phone})` : ""}`);
    
    // Calculate pending info
    if (cId) {
      const info = getPendingInfo(cId);
      setPendingInfo(info);
    } else {
      setPendingInfo(null);
    }
  };

  const getPendingInfo = (customerId) => {
    if (!customerId || !bills.length) return null;
    
    const pendingBills = bills.filter(b => {
      if (b.customerId !== customerId) return false;
      const bal = Number(b.balance || 0);
      return (!b.paid) || bal > 0 || (b.status && (b.status === 'Partial' || b.status === 'Unpaid'));
    });

    if (pendingBills.length === 0) return null;

    const totalPending = pendingBills.reduce((sum, b) => sum + Number(b.balance || b.total || 0), 0);
    const oldestBill = pendingBills.reduce((oldest, current) => {
      return new Date(current.createdAt) < new Date(oldest.createdAt) ? current : oldest;
    }, pendingBills[0]);

    const diffTime = Math.abs(new Date() - new Date(oldestBill.createdAt));
    const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));

    return {
      count: pendingBills.length,
      total: totalPending,
      daysPast: diffDays,
      oldestInvoice: oldestBill.invoice,
      bills: pendingBills
    };
  };

  const clearSelectedCustomer = () => {
    setSelectedCustomerId(null);
    setCustomerSearch("");
    setPendingInfo(null);
    setShowPendingDetails(false);
  };

  const handleSaveNewCustomer = async () => {
    try {
      // Basic validation
      const name = (customer.name || "").trim();
      const phone = String(customer.phone || "").trim();
      const address = (customer.address || "").trim();
      const email = (customer.email || "").trim();

      if (!name || !phone) {
        notify("Please enter customer name and phone number.", 'error');
        return;
      }

      // If a customer with same phone exists locally, prefer selecting it
      const existingLocal = customers.find(c => String(c.phone) === phone);
      if (existingLocal) {
        selectCustomer(existingLocal);
        notify("Customer with this phone already exists. Selected existing record.", 'info');
        return;
      }

      setSavingCustomer(true);


      const res = await api.post(API_CUSTOMERS, { name, phone, email, address });
      const data = res.data;

        if (res.status === 409) {
          // Exists on server; try to select it locally after refreshing list
          await fetchCustomers();
          const match = customers.find(c => String(c.phone) === phone);
          if (match) {
            selectCustomer(match);
          }
          notify(data?.message || "Customer already exists.", 'error');
          setSavingCustomer(false);
          return;
        }

      if (!res.ok || !data?.success) {
        notify(data?.message || "Failed to save customer.", 'error');
        setSavingCustomer(false);
        return;
      }

      const saved = data.data;
      // Update UI selection and list
      setSelectedCustomerId(saved._id);
      setCustomer({
        name: saved.name || name,
        address: saved.address || address,
        phone: saved.phone || phone,
        email: saved.email || email,
      });
      setCustomerSearch(`${saved.name}${saved.phone ? ` (${saved.phone})` : ""}`);
      await fetchCustomers();
      notify("Customer saved successfully.", 'success');
    } catch (err) {
      console.error("Save customer error:", err);
      notify("Unexpected error while saving customer.", 'error');
    } finally {
      setSavingCustomer(false);
    }
  };

  // ---------------------- LOAD PRODUCT PRICE/QTY ----------------------
  // (No batch loading needed in wholesale mode)

  const calculateFreeQty = (product, qty) => {
    if (!product || !product.offers || product.offers.length === 0) return 0;
    
    let remainingQty = Number(qty);
    let totalFreeQty = 0;
    
    // Sort tiers by buyQty descending
    const sortedOffers = [...product.offers]
      .filter(o => Number(o.buyQty) > 0)
      .sort((a, b) => Number(b.buyQty) - Number(a.buyQty));
      
    for (const offer of sortedOffers) {
      if (remainingQty <= 0) break;
      const count = Math.floor(remainingQty / Number(offer.buyQty));
      if (count > 0) {
        totalFreeQty += count * Number(offer.freeQty);
        remainingQty -= count * Number(offer.buyQty);
      }
    }
    
    return totalFreeQty;
  };

  // ---------------------- ADD ITEM (Wholesale - direct from product) ----------------------
  const addItem = () => {
    const product = products.find((p) => p.name === selectedProduct);

    if (!product) return notify("Select a valid product", 'error');
    if (!qty || Number(qty) <= 0) return notify("Enter a valid quantity", 'error');
    if (Number(qty) > product.quantity) return notify(`Not enough stock! Available: ${product.quantity}`, 'error');

    const freeQty = calculateFreeQty(product, qty);
    const exists = items.find((i) => i._id === product._id);

    if (exists) {
      setItems(
        items.map((i) =>
          i._id === product._id
            ? (() => {
                const newQty = i.qty + Number(qty);
                const newFreeQty = calculateFreeQty(product, newQty);
                const itemSubtotal = i.price * newQty;
                const cgst = itemSubtotal * (i.gst / 100) / 2;
                const sgst = itemSubtotal * (i.gst / 100) / 2;
                const total = itemSubtotal + cgst + sgst;
                return { ...i, qty: newQty, freeQty: newFreeQty, cgst, sgst, total };
              })()
            : i
        )
      );
    } else {
      setItems([
        ...items,
        {
          _id: product._id,
          name: product.name,
          gst: product.gst,
          hsn: product.hsn || "",
          price: product.price,
          cgst: product.price * Number(qty) * (product.gst / 100) / 2,
          sgst: product.price * Number(qty) * (product.gst / 100) / 2,
          qty: Number(qty),
          freeQty: freeQty,
          total: product.price * Number(qty) + (product.price * Number(qty) * (product.gst / 100)),
        },
      ]);
    }

    setQty("");
    setProductSearch("");
    setSelectedProduct("");
  };

  // ---------------------- UPDATE QUANTITY ----------------------
  const updateQty = (id, newQty) => {
    const item = items.find((i) => i._id === id);
    if (!item) return;
    const product = products.find(p => p._id === id);
    if (newQty < 1) return;

    setItems(
      items.map((i) =>
        i._id === id
          ? (() => {
              const freeQty = calculateFreeQty(product, newQty);
              const itemSubtotal = i.price * newQty;
              const cgst = itemSubtotal * (i.gst / 100) / 2;
              const sgst = itemSubtotal * (i.gst / 100) / 2;
              const total = itemSubtotal + cgst + sgst;
              return { ...i, qty: newQty, freeQty, cgst, sgst, total };
            })()
          : i
      )
    );
  };

  // ---------------------- REMOVE ITEM ----------------------
  const removeItem = (id) => {
    setItems(items.filter((i) => i._id !== id));
  };

  // ---------------------- BILL CALCULATIONS ----------------------
  const subtotal = items.reduce((sum, i) => sum + i.price * i.qty, 0);
  const gst = items.reduce((sum,i)=> sum + i.cgst + i.sgst, 0);
  const total = subtotal - (subtotal * discount) / 100 + gst;

  const generateInvoiceNumber = () => {
    const now = new Date();
    const month = String(now.getMonth() + 1).padStart(2, '0');
    const year = String(now.getFullYear()).slice(-2);
    
    // Filter bills for current MMYY (assumes invoice stored as string)
    const periodBills = bills.filter(bill => {
      if (!bill.invoice) return false;
      const match = bill.invoice.match(/#(\d{2})(\d{2})(\d{4})/);
      return match && match[1] === month && match[2] === year;
    });
    
    // Get highest sequence number (or 0)
    let maxSeq = 0;
    periodBills.forEach(bill => {
      const match = bill.invoice.match(/#(\d{2})(\d{2})(\d{4})/);
      if (match) {
        const seq = parseInt(match[3], 10);
        if (seq > maxSeq) maxSeq = seq;
      }
    });
    
    const nextSeq = String(maxSeq + 1).padStart(4, '0');
    return `#${month}${year}${nextSeq}`;
  };

  // ---------------------- COMPLETE PAYMENT ----------------------
  const handlePayment = async () => {
    if (items.length === 0) return notify("Add some items first!", 'error');

    // Update stock
    for (const item of items) {
      const batch = batches.find((b) => b.batchNumber === item.batchNumber);
      const newStock = (batch?.quantity ?? 0) - item.qty;
      await api.put(`${API_PRODUCTS}/${item._id}`, { batchNumber: item.batchNumber, quantity: newStock });
    }

    const invoiceNo = generateInvoiceNumber();

    // Build payload supporting partial payments
    const payload = {
      invoice: invoiceNo,
      customerName: customer.name || "No Name",
      customerAddress: customer.address,
      customerPhone: customer.phone,
      customerEmail: customer.email,
      ...(selectedCustomerId ? { customerId: selectedCustomerId } : {}),
      items: items.map(i => ({
        ...i,
        freeQty: i.freeQty || 0,
        totalQty: (i.qty || 0) + (i.freeQty || 0)
      })),
      subtotal,
      discount,
      gst,
      total,
      paymentMethod: payment,
    };

    if (paymentType === 'full') {
      payload.paid = true;
      payload.payments = [{ amount: Number(total) || 0, method: payment, date: Date.now() }];
      payload.balance = 0;
      payload.status = 'Paid';
    } else {
      // partial
      const paidAmt = Number(amountPaid) || 0;
      if (paidAmt < 0) return notify('Enter a valid partial payment amount', 'error');
      if (paidAmt > total) return notify('Paid amount cannot exceed total', 'error');

      payload.paid = false;
      payload.payments = [{ amount: paidAmt, method: payment, date: Date.now() }];
      payload.balance = Number(total) - paidAmt;
      payload.status = (payload.balance === 0) ? 'Paid' : 'Partial';
    }

    const res = await api.post(API_BILLS, payload);
    if (res.status >= 200 && res.status < 300) {
      notify("Bill created successfully!", 'success');
      setItems([]);
      setCustomer({ name: "", address: "", phone: "" , email: ""});
      setDiscount(0);
      setPayment("Cash");
      setPaymentType('full');
      setAmountPaid(0);
      setSelectedProduct("");
      setProductSearch("");
      setPendingInfo(null);
      setShowPendingDetails(false);
      fetchProducts();
      fetchBills();
      fetchCustomers();
      // If partial, navigate to payments due page so user can update further payments
      if (paymentType === 'partial') {
        try {
          sessionStorage.setItem('page', 'admin_payments_due');
          window.location.reload();
        } catch (e) {
          // fallback: just inform user
        }
      }
    } else {
      notify("Failed to save bill!", 'error');
    }
  };

  // Add this function inside your component to create bill print data
  const getBillPrintData = (bill) => {

    /* ================= NUMBER TO WORDS (INDIAN) ================= */
    const numberToWords = (num) => {
      const a = [
        "", "One", "Two", "Three", "Four", "Five", "Six", "Seven",
        "Eight", "Nine", "Ten", "Eleven", "Twelve", "Thirteen",
        "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen"
      ];
      const b = ["", "", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety"];

      const inWords = (n) => {
        if (n < 20) return a[n];
        if (n < 100) return b[Math.floor(n / 10)] + " " + a[n % 10];
        if (n < 1000) return a[Math.floor(n / 100)] + " Hundred " + inWords(n % 100);
        if (n < 100000) return inWords(Math.floor(n / 1000)) + " Thousand " + inWords(n % 1000);
        if (n < 10000000) return inWords(Math.floor(n / 100000)) + " Lakh " + inWords(n % 100000);
        return "";
      };

      return inWords(Math.floor(num)) + " Rupees Only";
    };

    // Calculate accurate totals from items
    const itemsWithTaxes = bill.items.map(item => {
      const itemSubtotal = item.price * item.qty;
      const cgst = itemSubtotal * (item.gst/2/100)
      const sgst = itemSubtotal * (item.gst/2/100)
      const gst = item.gst
      
      return {
        ...item,
        subtotal: itemSubtotal,
        gst: gst,
        cgst: cgst.toFixed(2),
        sgst: sgst.toFixed(2),
        total: (itemSubtotal + cgst + sgst).toFixed(2)
      };
    });

    // Overall calculations
    const grandSubtotal = bill.items.reduce((sum, item) => sum + item.price * item.qty, 0);
    const totalGst = itemsWithTaxes.reduce((sum, item) => sum + (parseFloat(item.cgst) + parseFloat(item.sgst)), 0);
    const grandTotal = parseFloat(bill.total.toFixed(2));

    return {
      // Invoice Details
      invoice: {
        number: bill.invoice,
        date: new Date(bill.createdAt).toLocaleDateString('en-IN'),
        dueDate: new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toLocaleDateString('en-IN') // 7 days from now
      },

      // Business Details (Update these with your actual info)
      business: {
        name: generalSettings.pharmacyName,
        address: generalSettings.address,
        dlNo: generalSettings.licenseNumber,
        gstin: generalSettings.gstNumber,
        contact: generalSettings.phone,
        email: generalSettings.email
      },

      // Customer Details
      customer: {
        name: bill.customerName || "Walk-in Customer",
        phone: bill.customerPhone || "Not Available",
        address: bill.customerAddress || "Address Not Available",
        email: bill.customerEmail || "Not Available"
      },

      // Items with tax breakdown
      items: itemsWithTaxes,

      // Summary Calculations
      summary: {
        subtotal: grandSubtotal.toFixed(2),
        discount: bill.discount || 0,
        discountAmount: ((grandSubtotal * (bill.discount || 0)) / 100).toFixed(2),
        taxableAmount: (grandSubtotal - ((grandSubtotal * (bill.discount || 0)) / 100)).toFixed(2),
        cgstTotal: (totalGst / 2).toFixed(2),
        sgstTotal: (totalGst / 2).toFixed(2),
        totalGst: totalGst.toFixed(2),
        grandTotal: grandTotal.toFixed(2)
      },

      // Payment Details
      payment: {
        method: bill.paymentMethod || "Cash",
        amount: grandTotal.toFixed(2),
        status: bill.paid ? "Paid" : "Pending"
      },

      // Formatted amounts for display
      formatted: {
        subtotal: grandSubtotal.toLocaleString('en-IN', { minimumFractionDigits: 2 }),
        grandTotal: grandTotal.toLocaleString('en-IN', { minimumFractionDigits: 2 }),
        words: numberToWords(grandTotal)
      },

      // Additional info
      placeOfSupply: "Dharmapuri",
      countryOfSupply: "India",
      terms: [
        "Goods once sold will not be taken back",
        "Please verify items before leaving counter"
      ],

      // Bank Details (Update with actual info)
      bank: {
        accountHolder: generalSettings?.accountHolder || "Farm Business",
        accountNumber: generalSettings?.accountNumber || "XXXXXXX",
        ifsc: generalSettings?.ifsc || "XXXXXXXX",
        accountType: "Current",
        bankName: generalSettings?.bankName || "Bank Name",
        upi: generalSettings?.upiId || "greendwarftech@uboi"
      }
    };
  };


  const printBill = async (billId) => {

    const bill = bills.find(b => b._id === billId);
    if (!bill) return;

    const printData = getBillPrintData(bill);
    const content = document.getElementById(`print-${billId}`);

    /* ================= TOTAL CALCULATION (FIXED) ================= */
    let totalAmount = 0;

    content.querySelectorAll("tr").forEach(row => {
      const cells = row.querySelectorAll("td");
      if (cells.length > 0) {
        const amountText = cells[cells.length - 1].innerText;
        const value = amountText.replace(/[₹,]/g, "").trim();
        totalAmount += Number(value) || 0;
      }
    });

    let dynamicQrUrl = ''; 
    try {
      const { qr } = await new UPIQR()
        .set({ 
          upiId: printData.bank.upi,
          name: printData.business.name,
          amount: Number(printData.summary.grandTotal),
          transactionNote: `Invoice${printData.invoice.number.slice(1)}`
        })
        .generate();
      
      dynamicQrUrl = qr;
    } catch (error) {
      console.error('QR Generation failed:', error);
      // setDynamicQrUrl(''); // Fallback to empty or static QR
    }

    const win = window.open("", "", "width=900,height=1000");

    win.document.write(`
      <!DOCTYPE html>
      <html lang="en">
      <head>
        <meta charset="UTF-8" />
        <title>Vendharaa Invoice ${printData.invoice.number}</title>
        <style>
          body { background:#fff; padding:12px; }
          .invoice-wrapper { max-width:780px; margin:0 auto; background:#fff; padding:14px 20px; }
          .invoice-header { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:10px; }
          .invoice-title { font-size:18px; font-weight:700; }
          .invoice-meta { margin-top:4px; font-size:10px; color:#555; line-height:1.4; }
          .logo { text-align:right; }
          .top-boxes { display:flex; gap:10px; margin-bottom:8px; }
          .card { flex:1; background:#f5f5f5; padding:8px 10px; border-radius:3px; font-size:10px; }
          .card-title { font-weight:700; margin-bottom:5px; font-size:10px; }
          .label { font-weight:600; margin-top:2px; }
          .label span { font-weight:400; }
          .sub-header { display:flex; justify-content:space-between; font-size:9px; margin:4px 2px 8px; color:#777; }
          .items-table { width:100%; border-collapse:collapse; font-size:10px; }
          .items-table thead { background:#2d5a27; color:#fff; }
          .items-table th, .items-table td { padding:4px 5px; }
          .items-table th { font-weight:500; text-align:left; }
          .items-table tbody td { border-bottom:1px solid #e0e0e0; height:22px; }
          .bottom-section { display:grid; grid-template-columns:2fr 1.5fr; gap:20px; margin-top:14px; align-items:flex-start; }
          .bank-details { font-size:10px; display:grid; grid-template-columns:1fr 90px; column-gap:12px; align-items:start; }
          .bank-details h3 { font-size:11px; margin-bottom:6px; }
          .bank-details .label { margin-top:3px; }
          .upi-qr-wrapper { justify-self:end; align-self:start; text-align:center; font-size:10px; color:#777; }
          .upi-caption { margin-bottom:4px; }
          .square-box { width:80px; height:80px; background:#222; color:#fff; display:flex; align-items:center; justify-content:center; font-size:10px; text-align:center; border-radius:3px; }
          .terms { margin-top:10px; font-size:10px; grid-column:1/-1; }
          .terms .label { margin-bottom:4px; }
          .amount-summary { font-size:11px; }
          .amount-summary-row { display:flex; justify-content:space-between; margin-bottom:3px; }
          .amount-summary-row.total { font-size:14px; font-weight:700; margin-top:6px; padding-top:5px; border-top:1px solid #e0e0e0; }
          .amount-summary-row.total span:last-child { font-size:15px; }
          .amount-summary h3 { font-size:13px; margin-bottom:6px; }
          .invoice-words { margin-top:6px; font-size:10px; color:#777; }
          .footer { margin-top:12px; font-size:10px; color:#777; display:flex; justify-content:space-between; align-items:center; border-top:1px solid #eee; padding-top:6px; }
          @media print {
            body { background:#fff; padding:0; -webkit-print-color-adjust:exact !important; }
            .invoice-wrapper { box-shadow:none; border:none; margin:0; max-width:100%; }
          }
        </style>
      </head>
      <body>
        <div class="invoice-wrapper">
          <!-- Header -->
          <div class="invoice-header">
            <div>
              <div class="invoice-title">Invoice</div>
              <div class="invoice-meta">
                Invoice: ${printData.invoice.number}<br />
                Invoice Date: ${printData.invoice.date}<br />
                Due Date: ${printData.invoice.dueDate}
              </div>
            </div>
            <div class="logo">
              <br/>
              ${logoSrc ? `<img src="${logoSrc}" style="max-height: 70px;" alt="Vendharaa Logo">` : ''}
            </div>
          </div>

          <!-- Billed by / Billed to -->
          <div class="top-boxes">
            <div class="card">
              <div class="card-title">Billed By</div>
              <div class="label">${printData.business.name}</div>
              ${printData.business.address}<br />
              <div class="label">DL No: <span>${printData.business.dlNo}</span></div>
              <div class="label">GSTIN: <span>${printData.business.gstin}</span></div>
              <div class="label">Contact No: <span>${printData.business.contact}</span></div>
              <div class="label">Email Id: <span>${printData.business.email}</span></div>
            </div>
            <div class="card">
              <div class="card-title">Billed To</div>
              <div class="label">${printData.customer.name}</div>
              ${printData.customer.address}<br />
              <div class="label">Contact No: <span>${printData.customer.phone}</span></div>
              <div class="label">Email Id: <span>${printData.customer.email}<span/></div>
            </div>
          </div>

          <div class="sub-header">
            <span>Place of Supply: ${printData.placeOfSupply}</span>
            <span>Country of supply: ${printData.countryOfSupply}</span>
          </div>

          <!-- Items table -->
          <table class="items-table">
            <thead>
              <tr>
                <th>Item Name & Batch</th>
                <th>HSN</th>
                <th>Price</th>
                <th>QTY</th>
                <th>GST</th>
                <th>Taxable Amount</th>
                <th>SGST</th>
                <th>CGST</th>
                <th>Amount</th>
              </tr>
            </thead>
            <tbody>
              ${printData.items.map(item => `
                <tr>
                  <td>${item.name}<br/><small>#${item.batchNumber}</small></td>
                  <td>3004XXXX</td>
                  <td>₹${parseFloat(item.price).toLocaleString('en-IN')}</td>
                  <td>${item.qty}</td>
                  <td>${item.gst}%</td>
                  <td>₹${parseFloat(item.subtotal).toLocaleString('en-IN')}</td>
                  <td>₹${parseFloat(item.sgst).toLocaleString('en-IN')}</td>
                  <td>₹${parseFloat(item.cgst).toLocaleString('en-IN')}</td>
                  <td>₹${item.total}</td>
                </tr>
              `).join('')}
              </tbody>
          </table>

          <!-- Bottom section with grid -->
          <div class="bottom-section">
            <!-- Bank & payment details + UPI QR -->
            <div class="bank-details">
              <div class="bank-left">
                <h3>Bank &amp; Payment Details</h3>
                <div class="label">Account Holder Name: <span>${printData.bank.accountHolder}</span></div>
                <div class="label">Account Number: <span>${printData.bank.accountNumber}</span></div>
                <div class="label">IFSC: <span>${printData.bank.ifsc}</span></div>
                <div class="label">Account Type: <span>${printData.bank.accountType}</span></div>
                <div class="label">Bank: <span>${printData.bank.bankName}</span></div>
                <div class="label">UPI: <span>${printData.bank.upi}</span></div>
              </div>

              <div class="upi-qr-wrapper">
                <div class="upi-caption">UPI - Scan To Pay</div>
                <div class="square-box">
                  <img src=${dynamicQrUrl} alt="UPI QR" width="100px" height="100px"/>
                </div>
              </div>

              <div class="terms">
                <div class="label">Terms and Conditions</div>
                1.<br />
                2.
              </div>
            </div>

            <!-- Amount summary -->
            <div class="amount-summary">
              <h3>Summary</h3>
              <div class="amount-summary-row">
                <span>Sub Total</span>
                <span>₹${printData.summary.subtotal}</span>
              </div>
              <div class="amount-summary-row">
                <span>Discount (${printData.summary.discount}%)</span>
                <span>₹${printData.summary.discountAmount}</span>
              </div>
              <div class="amount-summary-row">
                <span>Taxable Amount</span>
                <span>₹${printData.summary.taxableAmount}</span>
              </div>
              <div class="amount-summary-row">
                <span>CGST</span>
                <span>₹${printData.summary.cgstTotal}</span>
              </div>
              <div class="amount-summary-row">
                <span>SGST</span>
                <span>₹${printData.summary.sgstTotal}</span>
              </div>

              <div class="amount-summary-row total">
                <span>Total</span>
                <span>₹${printData.summary.grandTotal}</span>
              </div>

              <div class="invoice-words">
                Invoice Total (In Words):<br />
                ${printData.formatted.words}
              </div>
            </div>
          </div>

          <!-- Footer with QR for detailed invoice -->
          <div class="footer">
            <div>
              For any enquiries, email us on ${printData.business.email}<br />
              or call us on ${printData.business.contact}
            </div>
          </div>
        </div>
      </body>
      </html>
    `);

    win.document.close();
    win.focus();

    // Delay for image rendering
    setTimeout(() => {
      requestAnimationFrame(() => {
        // win.print();
        // win.close();
      });
    }, 100);
    
  };

  const downloadBill = async (billId, invoice) => {
    const bill = bills.find(b => b._id === billId);
    if (!bill) return;

    const printData = getBillPrintData(bill);

    let dynamicQrUrl = ''; 
    try {
      const { qr } = await new UPIQR()
        .set({ 
          upiId: printData.bank.upi,
          name: printData.business.name,
          amount: Number(printData.summary.grandTotal),
          transactionNote: `Invoice${printData.invoice.number.slice(1)}`
        })
        .generate();
      
      dynamicQrUrl = qr;
    } catch (error) {
      console.error('QR Generation failed:', error);
      // setDynamicQrUrl(''); // Fallback to empty or static QR
    }

    // Create a VISIBLE temp container (will be removed after download)
    const container = document.createElement('div');
    container.id = 'pdf-container';
    container.style.cssText = `
      position: absolute;
      top: 0;
      left: 0;
      width: 794px;  /* Exact A4 width */
      height: auto;
      background: white;
      z-index: 999999;
      margin: 0 !important;
      padding: 0 !important;
      box-sizing: border-box;
    `;
    
    // COMPLETE HTML WITH PDF-OPTIMIZED CSS
    container.innerHTML = `
        <!DOCTYPE html>
    <html lang="en">
    <head>
      <meta charset="UTF-8" />
      <title>Vendharaa Invoice ${printData.invoice.number}</title>
      <style>
        * { box-sizing:border-box; margin:0; padding:0; font-family:"Helvetica Neue",Arial,sans-serif; }
        body { background:#fff; padding:10px; }
        .invoice-wrapper { max-width:780px; margin:0 auto; background:#fff; padding:14px 20px; }
        .invoice-header { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:10px; }
        .invoice-title { font-size:18px; font-weight:700; }
        .invoice-meta { margin-top:4px; font-size:10px; color:#555; line-height:1.4; }
        .logo { text-align:right; }
        .top-boxes { display:flex; gap:10px; margin-bottom:8px; }
        .card { flex:1; background:#f5f5f5; padding:8px 10px; border-radius:3px; font-size:10px; }
        .card-title { font-weight:700; margin-bottom:5px; font-size:10px; }
        .label { font-weight:600; margin-top:2px; }
        .label span { font-weight:400; }
        .sub-header { display:flex; justify-content:space-between; font-size:9px; margin:4px 2px 8px; color:#777; }
        .items-table { width:100%; border-collapse:collapse; font-size:10px; }
        .items-table thead { background:#2d5a27; color:#fff; }
        .items-table th, .items-table td { padding:4px 5px; }
        .items-table th { font-weight:500; text-align:left; }
        .items-table tbody td { border-bottom:1px solid #e0e0e0; height:22px; }
        .bottom-section { display:grid; grid-template-columns:2fr 1.5fr; gap:20px; margin-top:14px; align-items:flex-start; }
        .bank-details { font-size:10px; display:grid; grid-template-columns:1fr 90px; column-gap:12px; align-items:start; }
        .bank-details h3 { font-size:11px; margin-bottom:6px; }
        .bank-details .label { margin-top:3px; }
        .upi-qr-wrapper { justify-self:end; align-self:start; text-align:center; font-size:10px; color:#777; }
        .upi-caption { margin-bottom:4px; }
        .square-box { width:80px; height:80px; background:#222; color:#fff; display:flex; align-items:center; justify-content:center; font-size:10px; text-align:center; border-radius:3px; }
        .terms { margin-top:10px; font-size:10px; grid-column:1/-1; }
        .terms .label { margin-bottom:4px; }
        .amount-summary { font-size:11px; }
        .amount-summary-row { display:flex; justify-content:space-between; margin-bottom:3px; }
        .amount-summary-row.total { font-size:14px; font-weight:700; margin-top:6px; padding-top:5px; border-top:1px solid #e0e0e0; }
        .amount-summary-row.total span:last-child { font-size:15px; }
        .amount-summary h3 { font-size:13px; margin-bottom:6px; }
        .invoice-words { margin-top:6px; font-size:10px; color:#777; }
        .footer { margin-top:12px; font-size:10px; color:#777; display:flex; justify-content:space-between; border-top:1px solid #eee; padding-top:6px; }
      </style>
    </head>
    <body>
      <div class="invoice-wrapper">
        <!-- Header -->
        <div class="invoice-header">
          <div>
            <div class="invoice-title">Invoice</div>
            <div class="invoice-meta">
              Invoice: ${printData.invoice.number}<br />
              Invoice Date: ${printData.invoice.date}<br />
              Due Date: ${printData.invoice.dueDate}
            </div>
          </div>
          <div class="logo">
            <br/>
            ${logoSrc ? `<img src="${logoSrc}" style="max-height: 70px;" alt="Vendharaa Logo">` : ''}
          </div>
        </div>

        <!-- Billed by / Billed to -->
        <div class="top-boxes">
          <div class="card">
            <div class="card-title">Billed By</div>
            <div class="label">${printData.business.name}</div>
            ${printData.business.address}<br />
            <div class="label">DL No: <span>${printData.business.dlNo}</span></div>
            <div class="label">GSTIN: <span>${printData.business.gstin}</span></div>
            <div class="label">Contact No: <span>${printData.business.contact}</span></div>
            <div class="label">Email Id: <span>${printData.business.email}</span></div>
          </div>
          <div class="card">
            <div class="card-title">Billed To</div>
            <div class="label">${printData.customer.name}</div>
            ${printData.customer.address}<br />
            <div class="label">Contact No: <span>${printData.customer.phone}</span></div>
            <div class="label">Email Id: <span>${printData.customer.email}<span/></div>
          </div>
        </div>

        <div class="sub-header">
          <span>Place of Supply: ${printData.placeOfSupply}</span>
          <span>Country of supply: ${printData.countryOfSupply}</span>
        </div>

        <!-- Items table -->
        <table class="items-table">
          <thead>
            <tr>
              <th>Item Name & Batch</th>
              <th>HSN</th>
              <th>Price</th>
              <th>QTY</th>
              <th>GST</th>
              <th>Taxable Amount</th>
              <th>SGST</th>
              <th>CGST</th>
              <th>Amount</th>
            </tr>
          </thead>
          <tbody>
            ${printData.items.map(item => `
              <tr>
                <td>${item.name}<br/><small>#${item.batchNumber}</small></td>
                <td>3004XXXX</td>
                <td>₹${parseFloat(item.price).toLocaleString('en-IN')}</td>
                <td>${item.qty}</td>
                <td>${item.gst}%</td>
                <td>₹${parseFloat(item.subtotal).toLocaleString('en-IN')}</td>
                <td>₹${parseFloat(item.sgst).toLocaleString('en-IN')}</td>
                <td>₹${parseFloat(item.cgst).toLocaleString('en-IN')}</td>
                <td>₹${item.total}</td>
              </tr>
            `).join('')}
            </tbody>
        </table>

        <!-- Bottom section with grid -->
        <div class="bottom-section">
          <!-- Bank & payment details + UPI QR -->
          <div class="bank-details">
            <div class="bank-left">
              <h3>Bank &amp; Payment Details</h3>
              <div class="label">Account Holder Name: <span>${printData.bank.accountHolder}</span></div>
              <div class="label">Account Number: <span>${printData.bank.accountNumber}</span></div>
              <div class="label">IFSC: <span>${printData.bank.ifsc}</span></div>
              <div class="label">Account Type: <span>${printData.bank.accountType}</span></div>
              <div class="label">Bank: <span>${printData.bank.bankName}</span></div>
              <div class="label">UPI: <span>${printData.bank.upi}</span></div>
            </div>

            <div class="upi-qr-wrapper">
              <div class="upi-caption">UPI - Scan To Pay</div>
              <div class="square-box">
                <img src=${dynamicQrUrl} alt="UPI QR" width="100px" height="100px"/>
              </div>
            </div>

            <div class="terms">
              <div class="label">Terms and Conditions</div>
              1.<br />
              2.
            </div>
          </div>

          <!-- Amount summary -->
          <div class="amount-summary">
            <h3>Summary</h3>
            <div class="amount-summary-row">
              <span>Sub Total</span>
              <span>₹${printData.summary.subtotal}</span>
            </div>
            <div class="amount-summary-row">
              <span>Discount (${printData.summary.discount}%)</span>
              <span>₹${printData.summary.discountAmount}</span>
            </div>
            <div class="amount-summary-row">
              <span>Taxable Amount</span>
              <span>₹${printData.summary.taxableAmount}</span>
            </div>
            <div class="amount-summary-row">
              <span>CGST</span>
              <span>₹${printData.summary.cgstTotal}</span>
            </div>
            <div class="amount-summary-row">
              <span>SGST</span>
              <span>₹${printData.summary.sgstTotal}</span>
            </div>

            <div class="amount-summary-row total">
              <span>Total</span>
              <span>₹${printData.summary.grandTotal}</span>
            </div>

            <div class="invoice-words">
              Invoice Total (In Words):<br />
              ${printData.formatted.words}
            </div>
          </div>
        </div>

        <!-- Footer with QR for detailed invoice -->
        <div class="footer">
          <div>
            For any enquiries, email us on ${printData.business.email}<br />
            or call us on ${printData.business.contact}
          </div>
        </div>
      </div>
    </body>
    </html>
    `;

    document.body.appendChild(container);

    // Generate PDF immediately (no delay needed for visible container)
    html2pdf()
      .set({
        filename: `${invoice}.pdf`,
        margin: [0, 0, 0, 0],
        image: { type: 'jpeg', quality: 1 },
        html2canvas: { 
          scale: 1.5,
          useCORS: true,
          letterRendering: true,
          allowTaint: true,
          width: 794,  // A4 width in pixels at 96dpi
          height: 1123 // A4 height in pixels at 96dpi
        },
        jsPDF: { 
          unit: 'mm', 
          format: 'a4', 
          orientation: 'portrait' 
        }
      })
      .from(container)
      .save()
      .then(() => {
        document.body.removeChild(container);
      })
      .catch(err => {
        console.error('PDF Error:', err);
        document.body.removeChild(container);
      });
  };

  return (
    <div>
      <div className="top-bar">
        <div>
          <div className="page-title">Create New Bill</div>
          <div className="page-subtitle">Point of Sale (POS) and Invoicing</div>
        </div>
      </div>
      <div className="page-content" style={{ paddingTop: '28px' }}>
        <div className="flex flex-col xl:flex-row gap-6">
          {/* POS Terminal - Left Column */}
          <div className="xl:flex-1 min-w-0 space-y-6">
            
            {/* Product Selector */}
            <div className="card-pro" style={{ padding: '24px' }}>
              <div className="flex items-center justify-between mb-6">
                <h2 className="text-base font-bold text-slate-800">Product Selection</h2>
                <div className="flex items-center gap-2">
                  <span className="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Scanner Active</span>
                  <div className="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
                </div>
              </div>
              
              <div className="relative group">
                <div className="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
                  <Package className="h-4 w-4 text-slate-400 group-focus-within:text-emerald-500 transition-colors" />
                </div>
                <input
                  type="text"
                  placeholder="Scan barcode or type product name (e.g. Urea, Seeds...)"
                  className="pro-input !pl-10 !py-3 !text-base shadow-sm"
                  value={productSearch}
                  onChange={(e) => setProductSearch(e.target.value)}
                />
              </div>

              {productSearch && (
                <div className="mt-2 border border-slate-100 rounded-xl bg-white shadow-xl max-h-60 overflow-y-auto z-20">
                  {filteredProducts.length === 0 ? (
                    <div className="p-4 text-center text-slate-500 text-sm italic">No matching products found</div>
                  ) : (
                    filteredProducts.map((p) => (
                      <div
                        key={p._id}
                        className="flex justify-between items-center px-6 py-4 border-b border-slate-50 last:border-0 hover:bg-emerald-50 cursor-pointer transition-colors group"
                        onClick={() => {
                          setSelectedProduct(p.name);
                          setProductSearch(p.name);
                        }}
                      >
                        <div className="flex flex-col">
                          <span className="text-sm font-bold text-slate-700">{p.name}</span>
                          <span className="text-[11px] text-slate-500 uppercase tracking-wider">{p.category || 'General'}</span>
                        </div>
                        <div className="flex items-center gap-4">
                          <div className="text-right">
                            <div className="text-sm font-bold text-slate-900">₹{p.price}</div>
                            <div className={`text-[10px] font-bold ${(p.quantity || 0) < 10 ? 'text-red-500' : 'text-slate-400'}`}>
                              STOCK: {p.quantity || 0}
                            </div>
                          </div>
                          <Plus className="h-4 w-4 text-slate-300 group-hover:text-emerald-600" />
                        </div>
                      </div>
                    ))
                  )}
                </div>
              )}

              {selectedProduct && (
                <div className="mt-4 flex items-center gap-4 p-4 bg-slate-50 rounded-xl border border-slate-100 animate-fade-in">
                  <div className="flex-1">
                    <span className="text-[10px] font-bold text-slate-400 uppercase">Selected Item</span>
                    <div className="text-sm font-bold text-slate-800">{selectedProduct}</div>
                  </div>
                  <div className="w-32">
                    <input
                      type="number"
                      placeholder="Qty"
                      className="pro-input !text-center !font-bold"
                      value={qty}
                      onChange={(e) => setQty(e.target.value)}
                      onKeyPress={(e) => e.key === 'Enter' && addItem()}
                      autoFocus
                    />
                  </div>
                  <button onClick={addItem} className="btn-primary !py-2.5">
                    <Plus size={16} /> Add to Cart
                  </button>
                </div>
              )}
            </div>

            {/* Cart Table */}
            <div className="card-pro overflow-hidden">
              <div className="border-b border-slate-100 flex items-center justify-between bg-slate-50/50" style={{ padding: '24px' }}>
                <h2 className="text-sm font-bold text-slate-800 uppercase tracking-wider">Cart Items ({items.length})</h2>
                <div className="text-xs font-medium text-slate-500 italic">Review items before generating invoice</div>
              </div>
              
              {items.length === 0 ? (
                <div className="p-12 text-center">
                  <div className="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4 border border-slate-100">
                    <ShoppingCart className="text-slate-300" size={24} />
                  </div>
                  <h3 className="text-slate-400 font-medium">Your cart is empty</h3>
                  <p className="text-slate-300 text-xs mt-1">Start adding products to create a bill</p>
                </div>
              ) : (
                <div className="overflow-x-auto">
                  <table className="pro-table">
                    <thead>
                      <tr>
                        <th>Product Details</th>
                        <th>HSN</th>
                        <th className="text-center">Quantity</th>
                        <th className="text-center">Free</th>
                        <th className="text-right">Unit Price</th>
                        <th className="text-right">Tax (GST)</th>
                        <th className="text-right">Amount</th>
                        <th className="text-center w-12"></th>
                      </tr>
                    </thead>
                    <tbody>
                      {items.map((i) => (
                        <tr key={i._id} className="group">
                          <td>
                            <div className="flex flex-col">
                              <span className="font-bold text-slate-800">{i.name}</span>
                              <span className="text-[10px] text-slate-400 uppercase tracking-tighter">Item ID: {i._id?.slice(-6)}</span>
                            </div>
                          </td>
                          <td className="text-slate-500 font-mono text-[11px]">{i.hsn || "—"}</td>
                          <td className="text-center">
                            <div className="flex items-center justify-center gap-2">
                              <button 
                                onClick={() => updateQty(i._id, Math.max(1, i.qty - 1))}
                                className="w-6 h-6 flex items-center justify-center rounded border border-slate-200 hover:bg-slate-100"
                              >-</button>
                              <span className="w-8 font-bold text-slate-800">{i.qty}</span>
                              <button 
                                onClick={() => updateQty(i._id, i.qty + 1)}
                                className="w-6 h-6 flex items-center justify-center rounded border border-slate-200 hover:bg-slate-100"
                              >+</button>
                            </div>
                          </td>
                          <td className="text-center">
                            <span className={`text-xs font-bold ${i.freeQty > 0 ? 'text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full' : 'text-slate-300'}`}>
                              {i.freeQty || 0}
                            </span>
                          </td>
                          <td className="text-right font-medium text-slate-700">₹{Number(i.price).toFixed(2)}</td>
                          <td className="text-right">
                            <div className="flex flex-col items-end">
                              <span className="text-xs font-bold text-slate-800">{i.gst}%</span>
                              <span className="text-[9px] text-slate-400 uppercase tracking-tighter">₹{(i.cgst + i.sgst).toFixed(2)} TAX</span>
                            </div>
                          </td>
                          <td className="text-right">
                            <span className="text-sm font-extrabold text-slate-900">₹{(i.total).toFixed(2)}</span>
                          </td>
                          <td className="text-center">
                            <button 
                              onClick={() => removeItem(i._id)} 
                              className="text-slate-300 hover:text-red-500 transition-colors"
                            >
                              <TrashIcon size={16} />
                            </button>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          </div>

          {/* Sidebar - Right Column */}
          <div className="xl:w-[380px] xl:flex-shrink-0 flex flex-col gap-5 min-w-0">
            
            {/* Customer Section */}
            <div className="card-pro border-emerald-100 bg-emerald-50/20" style={{ padding: '24px' }}>
              <div className="flex items-center justify-between mb-6">
                <h3 className="text-sm font-bold text-slate-800 uppercase tracking-wider">Customer Details</h3>
                <UsersIcon size={16} className="text-emerald-600" />
              </div>

              {/* Search Toggle */}
              <div className="relative mb-4">
                <input
                  type="text"
                  placeholder="Search registered customers..."
                  className="pro-input !bg-white !pl-9"
                  value={customerSearch}
                  onChange={(e) => setCustomerSearch(e.target.value)}
                />
                <Search className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" size={14} />
                
                {customerSearch && (
                  <div className="absolute top-full left-0 right-0 mt-1 border border-slate-100 rounded-xl bg-white shadow-xl max-h-60 overflow-y-auto z-30">
                    {filteredCustomers.length === 0 ? (
                      <div className="p-4 text-center text-slate-500 text-xs italic">No matching records</div>
                    ) : (
                      filteredCustomers.map((c) => (
                        <div 
                          key={c._id || c.id}
                          className="px-6 py-4 border-b border-slate-50 last:border-0 hover:bg-emerald-50 cursor-pointer transition-colors"
                          onClick={() => selectCustomer(c)}
                        >
                          <div className="font-bold text-slate-800 text-sm">{c.name}</div>
                          <div className="text-[10px] text-slate-500 font-medium">{c.phone || c.mobile || "No phone"}</div>
                        </div>
                      ))
                    )}
                  </div>
                )}
              </div>

              {selectedCustomerId ? (
                <div className="p-4 bg-emerald-600 rounded-xl text-white shadow-lg animate-fade-in relative overflow-hidden group">
                  <div className="absolute top-0 right-0 p-8 opacity-10 group-hover:scale-110 transition-transform">
                    <UsersIcon size={80} />
                  </div>
                  <div className="relative">
                    <div className="text-[10px] font-bold uppercase opacity-80 mb-1">Registered Customer</div>
                    <div className="text-base font-bold truncate">{customers.find(c => (c._id || c.id) === selectedCustomerId)?.name}</div>
                    <div className="text-xs opacity-90 mt-1">{customers.find(c => (c._id || c.id) === selectedCustomerId)?.phone}</div>
                    <button 
                      onClick={clearSelectedCustomer} 
                      className="mt-3 text-[10px] font-bold uppercase tracking-widest bg-white/20 hover:bg-white/30 px-3 py-1.5 rounded transition-colors"
                    >Change Customer</button>
                  </div>
                </div>
              ) : (
                <div className="space-y-3">
                  <div className="text-center py-2">
                    <span className="text-[10px] font-bold text-slate-400 uppercase tracking-widest">— OR NEW CUSTOMER —</span>
                  </div>
                  <input
                    type="text"
                    placeholder="Full Name"
                    className="pro-input !bg-white"
                    value={customer.name}
                    onChange={(e) => setCustomer({ ...customer, name: e.target.value })}
                  />
                  <input
                    type="text"
                    placeholder="Phone Number"
                    className="pro-input !bg-white"
                    value={customer.phone}
                    onChange={(e) => setCustomer({ ...customer, phone: e.target.value })}
                  />
                  <button
                    onClick={handleSaveNewCustomer}
                    disabled={savingCustomer || !(customer.name && customer.phone)}
                    className="btn-secondary !w-full !justify-center !py-2.5 !bg-white hover:!bg-slate-50 transition-colors"
                  >
                    {savingCustomer ? "Saving..." : "Register & Select"}
                  </button>
                </div>
              )}

              {/* Pending Info Alert */}
              {selectedCustomerId && pendingInfo && (
                <div className="mt-4 rounded-xl bg-red-50 border border-red-100 animate-fade-up" style={{ padding: '24px' }}>
                  <div className="flex items-center gap-2 mb-2">
                    <AlertTriangle size={16} className="text-red-600" />
                    <span className="text-xs font-bold text-red-900 uppercase">Outstanding Dues</span>
                  </div>
                  <div className="text-xl font-black text-red-900">₹{pendingInfo.total.toFixed(2)}</div>
                  <div className="text-[10px] text-red-700 mt-1 font-medium">Pending across {pendingInfo.count} invoices</div>
                  <button 
                    onClick={() => setShowPendingDetails(!showPendingDetails)}
                    className="mt-2 text-[10px] font-bold uppercase text-red-800 underline underline-offset-4"
                  >{showPendingDetails ? "Hide List" : "View Details"}</button>
                </div>
              )}
            </div>

            {/* Checkout Section - Enterprise Invoice Summary */}
            <div className="rounded-3xl border border-slate-100 bg-white shadow-2xl overflow-hidden">

              {/* ── Header ── */}
              <div className="px-6 py-5 border-b border-slate-100 flex items-center justify-between bg-gradient-to-r from-slate-50 to-white">
                <div>
                  <p className="text-[10px] font-black uppercase tracking-[0.25em] text-slate-400 mb-0.5">Invoice Summary</p>
                  <h3 className="text-lg font-black text-slate-900">Payment Checkout</h3>
                </div>
                <div className="w-10 h-10 rounded-2xl bg-emerald-500/10 flex items-center justify-center">
                  <ShoppingCart size={18} className="text-emerald-600" />
                </div>
              </div>

              {/* ── Line Items ── */}
              <div className="px-6 py-5 space-y-3 border-b border-slate-100">
                <div className="flex items-center justify-between py-1">
                  <span className="text-sm font-semibold text-slate-500">Subtotal</span>
                  <span className="text-base font-bold text-slate-800">₹{subtotal.toFixed(2)}</span>
                </div>
                <div className="flex items-center justify-between py-1">
                  <span className="text-sm font-semibold text-slate-500">GST &amp; Taxes</span>
                  <span className="text-base font-bold text-slate-800">₹{gst.toFixed(2)}</span>
                </div>
                {discount > 0 && (
                  <div className="flex items-center justify-between py-1">
                    <span className="text-sm font-semibold text-emerald-600">Discount ({discount}%)</span>
                    <span className="text-base font-bold text-emerald-600">− ₹{((subtotal * discount) / 100).toFixed(2)}</span>
                  </div>
                )}
              </div>

              {/* ── Grand Total ── */}
              <div className="px-6 py-5 bg-slate-900 relative overflow-hidden">
                <div className="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(16,185,129,0.15),_transparent_60%)] pointer-events-none"></div>
                <div className="relative">
                  <p className="text-[10px] font-bold text-slate-500 uppercase tracking-[0.2em] mb-1">Grand Total</p>
                  <div className="flex items-center justify-between gap-2">
                    <div className="text-3xl font-black text-white tracking-tight truncate">₹{total.toFixed(2)}</div>
                    <div className="text-right flex-shrink-0">
                      <div className="text-[10px] font-bold text-emerald-400 uppercase tracking-wider">{items.length} Item{items.length !== 1 ? 's' : ''}</div>
                      <div className="text-xs font-semibold text-slate-500 mt-0.5">{payment}</div>
                    </div>
                  </div>
                </div>
              </div>

              {/* ── Controls ── */}
              <div className="px-6 py-5 space-y-5">

                {/* Discount */}
                <div>
                  <p className="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2">Discount (%)</p>
                  <div className="relative">
                    <input
                      type="number"
                      min="0"
                      max="100"
                      className="w-full h-10 bg-slate-50 border-2 border-slate-100 focus:border-emerald-500 focus:bg-white rounded-xl px-4 pr-10 text-sm font-bold text-slate-900 outline-none transition-all"
                      placeholder="0"
                      value={discount || ''}
                      onChange={(e) => setDiscount(Math.min(100, Math.max(0, Number(e.target.value) || 0)))}
                    />
                    <span className="absolute right-5 top-1/2 -translate-y-1/2 text-slate-400 text-sm font-black">%</span>
                  </div>
                </div>

                {/* Payment Terms */}
                <div>
                  <p className="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2">Payment Terms</p>
                  <div className="grid grid-cols-2 gap-3">
                    {[['full', 'Full Payment'], ['partial', 'Partial']].map(([val, label]) => (
                      <button
                        key={val}
                        onClick={() => setPaymentType(val)}
                        className={`py-2.5 px-3 rounded-xl border-2 text-xs font-black transition-all ${
                          paymentType === val
                            ? 'border-emerald-500 bg-emerald-50 text-emerald-700 shadow-md shadow-emerald-100'
                            : 'border-slate-100 bg-white text-slate-400 hover:border-slate-200'
                        }`}
                      >
                        {label}
                      </button>
                    ))}
                  </div>
                </div>

                {/* Partial amount input */}
                {paymentType === 'partial' && (
                  <div>
                    <p className="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2">Amount Paid Now</p>
                    <div className="relative">
                      <span className="absolute left-5 top-1/2 -translate-y-1/2 text-slate-400 text-xl font-black">₹</span>
                      <input
                        type="number"
                        className="w-full h-12 bg-slate-50 border-2 border-slate-100 focus:border-emerald-500 focus:bg-white rounded-xl pl-10 pr-5 text-base font-black text-slate-900 outline-none transition-all"
                        placeholder="0.00"
                        value={amountPaid}
                        onChange={(e) => setAmountPaid(e.target.value)}
                      />
                    </div>
                  </div>
                )}

                {/* Payment Method */}
                <div>
                  <p className="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2">Payment Method</p>
                  <div className="grid grid-cols-3 gap-3">
                    {['Cash', 'Card', 'UPI'].map(m => (
                      <button
                        key={m}
                        onClick={() => setPayment(m)}
                        className={`py-2.5 rounded-xl border-2 text-xs font-black transition-all ${
                          payment === m
                            ? 'bg-slate-900 border-slate-900 text-white shadow-lg'
                            : 'bg-white border-slate-100 text-slate-500 hover:border-slate-300'
                        }`}
                      >{m}</button>
                    ))}
                  </div>
                </div>

                {/* CTA */}
                <button
                  onClick={handlePayment}
                  disabled={items.length === 0 || (!selectedCustomerId && !customer.name)}
                  className="w-full py-4 bg-emerald-600 hover:bg-emerald-700 active:scale-[0.98] text-white text-base font-black rounded-2xl shadow-lg shadow-emerald-200 transition-all disabled:opacity-30 disabled:grayscale disabled:shadow-none"
                >
                  Generate Invoice
                </button>

                <p className="text-center text-[10px] text-slate-400 font-medium">All transactions are securely recorded</p>
              </div>
            </div>
          </div>
        </div>

        {/* ═══ Invoice History ═══ */}
        <div className="mt-16">

          {/* Section Header */}
          <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
            <div>
              <h2 className="text-2xl font-black text-slate-900">Invoice History</h2>
              <p className="text-sm text-slate-500 mt-1">{bills.length} total records — click any row to view full details</p>
            </div>
            <div className="flex items-center gap-3">
              {/* Search */}
              <div className="relative">
                <Search className="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400" size={15} />
                <input
                  type="text"
                  placeholder="Search customer, invoice..."
                  value={billSearch}
                  onChange={e => setBillSearch(e.target.value)}
                  className="pl-10 pr-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm text-slate-800 placeholder:text-slate-400 outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 w-64 transition-all"
                />
              </div>
              {/* Status filter */}
              <div className="flex items-center bg-slate-100 rounded-xl p-1 gap-1">
                {['All', 'Paid', 'Partial', 'Unpaid'].map(f => (
                  <button key={f} onClick={() => setBillStatusFilter(f)}
                    className={`px-4 py-2 rounded-lg text-xs font-black transition-all ${
                      billStatusFilter === f ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-500 hover:text-slate-700'
                    }`}>{f}</button>
                ))}
              </div>
            </div>
          </div>

          {/* Bills Table */}
          <div className="bg-white rounded-3xl border border-slate-100 shadow-xl overflow-hidden">
            <table className="w-full">
              <thead>
                <tr className="bg-slate-50 border-b border-slate-100">
                  <th className="px-8 py-5 text-left text-[10px] font-black text-slate-400 uppercase tracking-[0.15em]">Invoice</th>
                  <th className="px-6 py-5 text-left text-[10px] font-black text-slate-400 uppercase tracking-[0.15em]">Customer</th>
                  <th className="px-6 py-5 text-left text-[10px] font-black text-slate-400 uppercase tracking-[0.15em]">Date</th>
                  <th className="px-6 py-5 text-left text-[10px] font-black text-slate-400 uppercase tracking-[0.15em]">Method</th>
                  <th className="px-6 py-5 text-right text-[10px] font-black text-slate-400 uppercase tracking-[0.15em]">Total</th>
                  <th className="px-6 py-5 text-center text-[10px] font-black text-slate-400 uppercase tracking-[0.15em]">Status</th>
                  <th className="px-6 py-5"></th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-50">
                {bills
                  .filter(b => {
                    const q = billSearch.toLowerCase();
                    const matchSearch = !q ||
                      (b.customerName || '').toLowerCase().includes(q) ||
                      (b.invoice || '').toLowerCase().includes(q) ||
                      (b.customerPhone || '').includes(q);
                    const matchStatus = billStatusFilter === 'All' || (b.status || (b.paid ? 'Paid' : 'Unpaid')) === billStatusFilter;
                    return matchSearch && matchStatus;
                  })
                  .map(b => (
                    <tr key={b._id}
                      onClick={() => setSelectedBill(b)}
                      className="hover:bg-emerald-50/40 cursor-pointer transition-colors group"
                    >
                      <td className="px-8 py-5">
                        <span className="font-mono text-sm font-bold text-slate-700">{b.invoice}</span>
                      </td>
                      <td className="px-6 py-5">
                        <div className="text-sm font-bold text-slate-800">{b.customerName || 'Walk-in'}</div>
                        <div className="text-[11px] text-slate-400">{b.customerPhone}</div>
                      </td>
                      <td className="px-6 py-5 text-sm text-slate-500">{new Date(b.createdAt).toLocaleDateString('en-IN')}</td>
                      <td className="px-6 py-5">
                        <span className="text-xs font-bold text-slate-600 bg-slate-100 px-3 py-1.5 rounded-lg">{b.paymentMethod}</span>
                      </td>
                      <td className="px-6 py-5 text-right">
                        <span className="text-base font-black text-slate-900">₹{Number(b.total).toFixed(2)}</span>
                      </td>
                      <td className="px-6 py-5 text-center">
                        <span className={`text-[11px] font-black px-3 py-1.5 rounded-lg ${
                          (b.status || (b.paid ? 'Paid' : 'Unpaid')) === 'Paid'
                            ? 'bg-emerald-100 text-emerald-700'
                            : (b.status === 'Partial' ? 'bg-amber-100 text-amber-700' : 'bg-red-100 text-red-700')
                        }`}>{b.status || (b.paid ? 'Paid' : 'Unpaid')}</span>
                      </td>
                      <td className="px-6 py-5">
                        <div className="flex items-center gap-2 justify-end" onClick={e => e.stopPropagation()}>
                          <button onClick={() => printBill(b._id)} className="text-[11px] font-bold text-slate-500 hover:text-slate-900 px-3 py-1.5 rounded-lg hover:bg-slate-100 transition-all">Print</button>
                          <button onClick={() => downloadBill(b._id, b.invoice)} className="text-[11px] font-bold text-slate-500 hover:text-slate-900 px-3 py-1.5 rounded-lg hover:bg-slate-100 transition-all">PDF</button>
                          <button onClick={async () => {
                              if (!window.confirm('Delete this invoice?')) return;
                              try { await api.delete(`${API_BILLS}/${b._id}`); notify('Invoice removed', 'success'); fetchBills(); }
                              catch { notify('Delete failed', 'error'); }
                            }}
                            className="p-2 rounded-lg text-slate-300 hover:text-red-500 hover:bg-red-50 transition-all"
                          ><Trash2 size={14} /></button>
                        </div>
                      </td>
                    </tr>
                  ))}
              </tbody>
            </table>
            {bills.filter(b => {
              const q = billSearch.toLowerCase();
              return (!q || (b.customerName||'').toLowerCase().includes(q) || (b.invoice||'').toLowerCase().includes(q)) &&
                (billStatusFilter === 'All' || (b.status||(b.paid?'Paid':'Unpaid')) === billStatusFilter);
            }).length === 0 && (
              <div className="py-20 text-center">
                <Search className="mx-auto text-slate-200 mb-4" size={40} />
                <p className="text-slate-400 font-semibold">No invoices match your search</p>
              </div>
            )}
          </div>

          {/* Hidden print divs */}
          {bills.map(b => (
            <div key={b._id} id={`print-${b._id}`} style={{ display: 'none' }}>
              <h2>Invoice: {b.invoice}</h2><p>Customer: {b.customerName}</p>
              {b.items?.map((item, i) => <div key={i}>{item.name} x{item.qty} = ₹{(item.price*item.qty).toFixed(2)}</div>)}
              <h3>Total: ₹{Number(b.total).toFixed(2)}</h3>
            </div>
          ))}
        </div>
      </div>

      {/* ═══ Bill Detail Slide-Over ═══ */}
      {selectedBill && (
        <div className="fixed inset-0 z-50 flex justify-end">
          <div className="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" onClick={() => setSelectedBill(null)} />
          <div className="relative w-full max-w-2xl bg-white h-full overflow-y-auto shadow-2xl flex flex-col">

            {/* Detail Header */}
            <div className="sticky top-0 bg-white border-b border-slate-100 px-10 py-7 flex items-center justify-between z-10">
              <div>
                <p className="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Invoice Detail</p>
                <h2 className="text-2xl font-black text-slate-900">{selectedBill.invoice}</h2>
              </div>
              <button onClick={() => setSelectedBill(null)} className="w-10 h-10 rounded-2xl bg-slate-100 hover:bg-slate-200 flex items-center justify-center transition-colors">
                <svg width="16" height="16" fill="none" stroke="currentColor" strokeWidth="2.5" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"/></svg>
              </button>
            </div>

            <div className="px-10 py-8 space-y-8 flex-1">
              {/* Status + Date */}
              <div className="flex items-center gap-4">
                <span className={`text-sm font-black px-4 py-2 rounded-xl ${
                  (selectedBill.status || (selectedBill.paid ? 'Paid' : 'Unpaid')) === 'Paid' ? 'bg-emerald-100 text-emerald-700'
                  : selectedBill.status === 'Partial' ? 'bg-amber-100 text-amber-700' : 'bg-red-100 text-red-700'
                }`}>{selectedBill.status || (selectedBill.paid ? 'Paid' : 'Unpaid')}</span>
                <span className="text-sm text-slate-500">{new Date(selectedBill.createdAt).toLocaleString('en-IN')}</span>
              </div>

              {/* Customer & Business */}
              <div className="grid grid-cols-2 gap-6">
                <div className="bg-slate-50 rounded-2xl p-6">
                  <p className="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-3">Billed To</p>
                  <p className="font-bold text-slate-900">{selectedBill.customerName || 'Walk-in Customer'}</p>
                  {selectedBill.customerPhone && <p className="text-sm text-slate-500 mt-1">{selectedBill.customerPhone}</p>}
                  {selectedBill.customerAddress && <p className="text-sm text-slate-500">{selectedBill.customerAddress}</p>}
                  {selectedBill.customerEmail && <p className="text-sm text-slate-500">{selectedBill.customerEmail}</p>}
                </div>
                <div className="bg-slate-50 rounded-2xl p-6">
                  <p className="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-3">Payment Info</p>
                  <p className="font-bold text-slate-900">{selectedBill.paymentMethod}</p>
                  <p className="text-sm text-slate-500 mt-1">Discount: {selectedBill.discount || 0}%</p>
                  {Number(selectedBill.balance) > 0 && <p className="text-sm font-bold text-red-600 mt-1">Balance: ₹{Number(selectedBill.balance).toFixed(2)}</p>}
                </div>
              </div>

              {/* Items Table */}
              <div>
                <p className="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-4">Line Items</p>
                <div className="bg-slate-50 rounded-2xl overflow-hidden">
                  <table className="w-full text-sm">
                    <thead>
                      <tr className="border-b border-slate-200">
                        <th className="px-6 py-4 text-left text-[10px] font-black text-slate-400 uppercase tracking-wider">Product</th>
                        <th className="px-4 py-4 text-center text-[10px] font-black text-slate-400 uppercase tracking-wider">Qty</th>
                        <th className="px-4 py-4 text-right text-[10px] font-black text-slate-400 uppercase tracking-wider">Rate</th>
                        <th className="px-4 py-4 text-right text-[10px] font-black text-slate-400 uppercase tracking-wider">GST</th>
                        <th className="px-6 py-4 text-right text-[10px] font-black text-slate-400 uppercase tracking-wider">Amount</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-slate-200">
                      {(selectedBill.items || []).map((item, i) => (
                        <tr key={i}>
                          <td className="px-6 py-4">
                            <p className="font-bold text-slate-800">{item.name}</p>
                            {item.hsn && <p className="text-[10px] text-slate-400">HSN: {item.hsn}</p>}
                          </td>
                          <td className="px-4 py-4 text-center font-bold text-slate-700">
                            {item.qty}{item.freeQty > 0 && <span className="ml-1 text-[10px] text-emerald-600">+{item.freeQty}F</span>}
                          </td>
                          <td className="px-4 py-4 text-right text-slate-600">₹{Number(item.price).toFixed(2)}</td>
                          <td className="px-4 py-4 text-right text-slate-500">{item.gst}%</td>
                          <td className="px-6 py-4 text-right font-black text-slate-900">₹{(item.price * item.qty * (1 + item.gst/100)).toFixed(2)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>

              {/* Summary */}
              <div className="bg-slate-900 rounded-2xl p-8 space-y-4">
                <div className="flex justify-between text-sm">
                  <span className="text-slate-400">Subtotal</span>
                  <span className="text-white font-bold">₹{Number(selectedBill.subtotal).toFixed(2)}</span>
                </div>
                <div className="flex justify-between text-sm">
                  <span className="text-slate-400">GST</span>
                  <span className="text-white font-bold">₹{Number(selectedBill.gst).toFixed(2)}</span>
                </div>
                {Number(selectedBill.discount) > 0 && (
                  <div className="flex justify-between text-sm">
                    <span className="text-slate-400">Discount ({selectedBill.discount}%)</span>
                    <span className="text-emerald-400 font-bold">−₹{(Number(selectedBill.subtotal) * Number(selectedBill.discount) / 100).toFixed(2)}</span>
                  </div>
                )}
                <div className="pt-4 border-t border-slate-700 flex justify-between">
                  <span className="text-slate-300 font-bold">Grand Total</span>
                  <span className="text-3xl font-black text-white">₹{Number(selectedBill.total).toFixed(2)}</span>
                </div>
              </div>

              {/* Actions */}
              <div className="flex gap-3 pb-4">
                <button onClick={() => { printBill(selectedBill._id); }} className="flex-1 py-4 rounded-2xl border-2 border-slate-200 text-sm font-black text-slate-700 hover:bg-slate-50 transition-all">Print Invoice</button>
                <button onClick={() => { downloadBill(selectedBill._id, selectedBill.invoice); }} className="flex-1 py-4 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-black transition-all shadow-lg shadow-emerald-200">Download PDF</button>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}



