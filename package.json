{
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "scripts": {
  "dev-server": "npm run dev --prefix backend",
  "dev-client": "npm run dev --prefix frontend",
  "dev": "concurrently \"npm run dev-server\" \"npm run dev-client\"",
  "install-server": "npm install --prefix backend",
  "install-client": "npm install --prefix frontend",
  "install": "concurrently \"npm run install-server\" \"npm run install-client\""
}
}
